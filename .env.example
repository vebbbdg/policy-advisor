# DeepSeek API Configuration
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS allowed origins (comma-separated). Default "*" disables credentials.
# For production, specify your frontend origin, e.g. https://your-app.com
CORS_ORIGINS=*

# Set to true ONLY for testing/fast startup: uses random vectors,
# RAG retrieval will have NO semantic meaning.
USE_FAKE_EMBEDDING=false

# Retrieval mode (phase 3.3):
#   hybrid (default) = BM25 + vector RRF fusion, best Recall@3 (0.906), no extra latency
#   rerank           = hybrid wide-recall + cross-encoder rerank, best precision, +0.5-1s latency
#   dense            = pure vector search, fastest, Recall@3 0.812
RETRIEVER_MODE=hybrid

# Rate limit for /api/chat-stream per client IP (phase 3.3, prevents API bill abuse).
# Format: "<count>/<period>", e.g. 20/hour, 5/minute.
CHAT_RATE_LIMIT=20/hour

# Daily LLM token budget (phase 3.3-C). Alert-only: when cumulative input+output
# tokens for the day reach this, a WARNING is logged (once per day) and current
# usage shows in /api/health. Set 0 to disable the alert. Never blocks requests.
DAILY_TOKEN_BUDGET=0

# Auth (phase 3.2). JWT signing secret - MUST be a strong random value in
# production or anyone can forge tokens. Leave unset locally to use an insecure
# dev default (a warning is logged on startup).
JWT_SECRET=

# Max messages a guest (not logged in) may send before being asked to log in.
GUEST_MESSAGE_LIMIT=5
